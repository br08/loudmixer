{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Windows: rodar (dev)",
      "detail": "Compila a versão Windows (Debug) a partir do WSL e a abre no Windows",
      "type": "shell",
      "command": "${workspaceFolder}/tools/windows-dev.sh run debug",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Windows: compilar (dev)",
      "type": "shell",
      "command": "${workspaceFolder}/tools/windows-dev.sh build debug",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Windows: testes",
      "type": "shell",
      "command": "${workspaceFolder}/tools/windows-dev.sh test debug",
      "group": "test",
      "problemMatcher": "$gcc"
    }
  ]
}
