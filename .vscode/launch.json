{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LoudMixer (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "stopAtEntry": false,
      "externalConsole": false,
      "setupCommands": [
        { "description": "Pretty printers", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "linux": {
        "miDebuggerPath": "gdb"
      },
      "windows": {
        "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
        "environment": [
          { "name": "PATH", "value": "C:/msys64/ucrt64/bin;${env:PATH}" }
        ]
      }
    },
    {
      "name": "LoudMixer (gdb, backend mock)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": ["--backend", "mock"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "linux": { "miDebuggerPath": "gdb" },
      "windows": {
        "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
        "environment": [
          { "name": "PATH", "value": "C:/msys64/ucrt64/bin;${env:PATH}" }
        ]
      }
    }
  ]
}
